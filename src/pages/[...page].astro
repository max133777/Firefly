---
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import CoverImage from "@/components/common/CoverImage.astro";
import Pagination from "@/components/common/Pagination.astro";
import PostPage from "@/components/layout/PostPage.astro";
import { profileConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getApiUrlList, processCoverImageSync } from "@/utils/image-utils";
import { getFileDirFromPath, getPostUrlBySlug, url } from "@/utils/url-utils";
export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	// 使用配置中的文章数量
	const pageSize = siteConfig.pagination.postsPerPage;
	return paginate(allBlogPosts, { pageSize });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props;

const len = page.data.length;

// 列表页隐藏的 h1：首屏用站点标题，后续页用「首页 · 页码」，避免空 h1
const heading =
	page.currentPage === 1
		? siteConfig.title
		: `${i18n(I18nKey.home)} · ${page.currentPage}`;

// 首页是否显示文章列表，见 siteConfig.home.showPostList
const homeConfig = siteConfig.home ?? {};
const showPostList = homeConfig.showPostList !== false;
const welcomeConfig = homeConfig.welcome ?? {};
// 欢迎卡片只在首页第一页、且不显示文章列表时出现
const showWelcome =
	!showPostList && page.currentPage === 1 && welcomeConfig.enable !== false;
const welcomeTitle = welcomeConfig.title || siteConfig.title;
const welcomeParagraphs = welcomeConfig.paragraphs ?? [];
const welcomeLinks = welcomeConfig.links ?? [];

// 首页「最新文章」区块，见 siteConfig.home.latestPosts
const latestConfig = homeConfig.latestPosts ?? {};
const latestCount = Math.max(1, Math.trunc(latestConfig.count ?? 3));
const latestTitle = latestConfig.title || "最新文章";
const latestShowMore = latestConfig.showMoreLink !== false;
const latestShowCategory = latestConfig.showCategory !== false;
// 只在首页第一页展示；条数按 published 倒序由 getSortedPosts 保证
const showLatest =
	latestConfig.enable !== false && page.currentPage === 1;
const latestPosts = showLatest
	? (await getSortedPosts()).slice(0, latestCount)
	: [];
---

<MainGridLayout heading={heading}>
  {
    showPostList ? (
      <PostPage page={page} />
    ) : (
      showWelcome && (
        <div class="card-base z-10 px-6 py-6 md:px-9 md:py-8 relative w-full mb-4 onload-animation">
          <h2 class="text-2xl md:text-3xl font-bold text-(--primary) mb-4">
            {welcomeTitle}
          </h2>
          {welcomeParagraphs.map((paragraph) => (
            <p class="text-neutral-700 dark:text-neutral-300 leading-relaxed mb-3 last:mb-0">
              {paragraph}
            </p>
          ))}
          {welcomeLinks.length > 0 && (
            <div class="flex flex-wrap gap-3 mt-6">
              {welcomeLinks.map((link) => (
                <a
                  href={link.url}
                  class="btn-regular rounded-lg h-10 px-4 inline-flex items-center gap-2 font-bold active:scale-95 transition-transform"
                >
                  {link.icon && <Icon name={link.icon} class="text-[1.25rem]" />}
                  <span>{link.name}</span>
                </a>
              ))}
            </div>
          )}
        </div>
      )
    )
  }
  {
    latestPosts.length > 0 && (
      <section
        class="w-full mb-4 onload-animation"
        style="animation-delay: calc(var(--content-delay) + 80ms)"
      >
        <div class="flex items-center justify-between gap-3 mb-3">
          <h2 class="text-xl md:text-2xl font-bold text-(--primary)">{latestTitle}</h2>
          {latestShowMore && (
            <a
              href={url("/archive/")}
              class="btn-plain rounded-lg h-9 px-3 inline-flex items-center gap-1 text-sm font-medium shrink-0"
            >
              <span>查看全部</span>
              <Icon name="material-symbols:chevron-right-rounded" class="text-base" />
            </a>
          )}
        </div>
        <div class="grid gap-4 grid-cols-2 lg:grid-cols-4">
          {latestPosts.map((post) => {
            const cover = processCoverImageSync(post.data.image, post.id);
            const apiUrls = getApiUrlList(post.data.image, post.id);
            const category = (post.data.category || "").trim();
            return (
              <a
                href={getPostUrlBySlug(post.id)}
                class="card-base group flex flex-col rounded-(--radius-large) overflow-hidden active:scale-[0.98] transition-transform"
              >
                <div
                  class="relative w-full overflow-hidden bg-black/5 dark:bg-white/5"
                  style="aspect-ratio: 16 / 9;"
                >
                  {cover ? (
                    <CoverImage
                      src={cover}
                      basePath={getFileDirFromPath(post.filePath || "")}
                      alt={post.data.title}
                      class="w-full h-full transition-transform duration-300 group-hover:scale-105"
                      preview={true}
                      loading="lazy"
                      apiUrls={apiUrls}
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center text-neutral-400 dark:text-neutral-500">
                      <Icon name="material-symbols:image-outline" class="text-3xl" />
                    </div>
                  )}
                </div>
                <div class="flex flex-col gap-2 p-3 md:p-4">
                  <h3 class="font-bold text-sm md:text-base leading-snug line-clamp-2 group-hover:text-(--primary) transition-colors">
                    {post.data.title}
                  </h3>
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-neutral-500 dark:text-neutral-400">
                    {latestShowCategory && category && (
                      <span class="inline-flex items-center gap-0.5 rounded-md bg-(--btn-regular-bg) text-(--primary) px-1.5 py-0.5 font-bold">
                        <Icon
                          name="material-symbols:label-outline-rounded"
                          class="text-xs"
                        />
                        {category}
                      </span>
                    )}
                    <span class="inline-flex items-center gap-1 min-w-0">
                      <Icon
                        name="material-symbols:person-outline-rounded"
                        class="text-sm shrink-0"
                      />
                      <span class="truncate">{post.data.author || profileConfig.name}</span>
                    </span>
                    <span class="inline-flex items-center gap-1">
                      <Icon
                        name="material-symbols:calendar-today-outline-rounded"
                        class="text-sm shrink-0"
                      />
                      <span>{formatDateToYYYYMMDD(post.data.published)}</span>
                    </span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )
  }
  {
    showPostList && page.total > page.size && (
      <Pagination
        class="mx-auto onload-animation"
        page={page}
        style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`}
      />
    )
  }
</MainGridLayout>

<script>
  // 响应式分页处理脚本
  document.addEventListener("DOMContentLoaded", function () {
    // 如果启用了响应式分页，添加相应的CSS类
    const responsiveEnabled = true; // ${siteConfig.pagination.responsive}
    if (responsiveEnabled) {
      const deviceType = getDeviceType();
      document.body.classList.add(`device-${deviceType}`);

      // 监听窗口大小变化
      let resizeTimeout: any;
      window.addEventListener("resize", function () {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(function () {
          const newDeviceType = getDeviceType();
          const currentDeviceType = document.body.className.match(
            /device-(mobile|tablet|desktop)/
          )?.[1];

          if (currentDeviceType !== newDeviceType) {
            document.body.classList.remove(`device-${currentDeviceType}`);
            document.body.classList.add(`device-${newDeviceType}`);
          }
        }, 250);
      });
    }
  });

  function getDeviceType() {
    if (typeof window === "undefined") return "desktop";

    const width = window.innerWidth;
    if (width < 768) return "mobile";
    if (width < 1024) return "tablet";
    return "desktop";
  }
</script>
