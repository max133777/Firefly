---
// 阅读数：卡片批量只读、文章页自增（同一浏览器每会话只 +1）。
// 放在 MainGridLayout 上每页渲染 —— Swup 站内切页时脚本不重跑的问题（见 skill 13.3）。
import { submitConfig } from "@/config/submitConfig";
---

<script is:inline define:vars={{ API_BASE: submitConfig.apiBase }} data-swup-ignore-script>
  (function () {
    var getCount = function (slug) {
      return fetch(API_BASE + "/api/views/" + encodeURIComponent(slug))
        .then(function (r) { return r.json(); })
        .then(function (d) { return d && d.ok ? d.views : null; })
        .catch(function () { return null; });
    };
    var fill = function (slug, n) {
      if (n === null || n === undefined) return;
      var nodes = document.querySelectorAll("[data-view-count]");
      for (var i = 0; i < nodes.length; i++) {
        if (nodes[i].getAttribute("data-view-count") === "" || nodes[i].getAttribute("data-view-count") === slug) {
          nodes[i].textContent = n;
        }
      }
    };
    function boot() {
      // 1) 卡片：只读
      var els = document.querySelectorAll("[data-view-slug]");
      var slugs = [];
      for (var i = 0; i < els.length; i++) {
        var s = els[i].getAttribute("data-view-slug");
        if (s && slugs.indexOf(s) < 0) slugs.push(s);
      }
      slugs.slice(0, 40).forEach(function (s) {
        getCount(s).then(function (n) { fill(s, n); });
      });

      // 2) 文章页：/posts/<slug>/ 时自增一次，并把头部那个占位填上
      var m = location.pathname.match(/^\/posts\/([^/]+)\//);
      if (m) {
        var slug = decodeURIComponent(m[1]);
        var key = "cyea-viewed:" + slug;
        if (!sessionStorage.getItem(key)) {
          sessionStorage.setItem(key, "1");
          fetch(API_BASE + "/api/views/" + encodeURIComponent(slug), { method: "POST" })
            .then(function (r) { return r.json(); })
            .then(function (d) { if (d && d.ok) fill(slug, d.views); })
            .catch(function () {});
        } else {
          getCount(slug).then(function (n) { fill(slug, n); });
        }
      }
    }
    boot();
    document.addEventListener("swup:contentReplaced", boot);
    document.addEventListener("firefly:page:loaded", boot);
  })();
</script>
